# =====================================================================
# storage/uploads/.htaccess
# Bloquea TODO acceso HTTP directo a los archivos subidos.
# Las descargas legítimas deben hacerse por un controlador PHP con guard.
# =====================================================================

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 (compatibilidad)
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Por si acaso: nunca ejecutar PHP/scripts dentro de esta carpeta.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|phar|php3|php4|php5|php7|php8|pl|py|jsp|asp|sh|cgi)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes -ExecCGI
